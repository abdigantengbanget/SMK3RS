rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /k3rs_shared_uploads/{uploadId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function hasValidUploadShape() {
        let data = request.resource.data;
        let evidence = data.document;
        return data.keys().hasOnly([
            'itemId',
            'document',
            'uploadedBy',
            'uploadedByUid',
            'uploadedAt'
          ])
          && data.keys().hasAll([
            'itemId',
            'document',
            'uploadedBy',
            'uploadedByUid',
            'uploadedAt'
          ])
          && data.itemId is string
          && data.itemId.matches('K3-[A-Z0-9-]+')
          && data.uploadedBy is string
          && data.uploadedBy.size() <= 100
          && data.uploadedByUid == request.auth.uid
          && evidence is map
          && evidence.keys().hasOnly([
            'id',
            'name',
            'docNumber',
            'uploadDate',
            'fileType',
            'fileSize',
            'mimeType',
            'isGDrive',
            'gdriveUrl',
            'verified'
          ])
          && evidence.keys().hasAll([
            'id',
            'name',
            'docNumber',
            'uploadDate',
            'fileType',
            'fileSize'
          ])
          && evidence.id == uploadId
          && evidence.name is string
          && evidence.name.size() <= 256
          && evidence.docNumber is string
          && evidence.docNumber.size() <= 128
          && evidence.uploadDate is string
          && evidence.fileType is string
          && evidence.fileSize is string
          && (!('isGDrive' in evidence) || evidence.isGDrive is bool)
          && (!('gdriveUrl' in evidence) ||
            (evidence.gdriveUrl is string && evidence.gdriveUrl.size() <= 2048))
          && data.uploadedAt is timestamp;
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn() && hasValidUploadShape();
      allow update: if isSignedIn()
        && resource.data.uploadedByUid == request.auth.uid
        && hasValidUploadShape();
      allow delete: if isSignedIn()
        && (resource.data.uploadedByUid == request.auth.uid
          || request.auth.token.firebase.sign_in_provider == 'google.com');
    }
  }
}
